<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.whoop.collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WHOOP_TOOLS_DIR__/.venv/bin/python</string>
    <string>__WHOOP_TOOLS_DIR__/collector.py</string>
    <string>--live</string><string>20</string>
  </array>
  <key>WorkingDirectory</key><string>__WHOOP_TOOLS_DIR__</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__WHOOP_TOOLS_DIR__/collector.out.log</string>
  <key>StandardErrorPath</key><string>__WHOOP_TOOLS_DIR__/collector.err.log</string>
</dict></plist>
