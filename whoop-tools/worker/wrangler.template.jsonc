// deploy.sh fills this in from your .env and writes wrangler.jsonc (gitignored).
{
  "name": "__NAME__",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "__DBNAME__", "database_id": "__DBID__" }],
  "observability": { "enabled": true }
}
