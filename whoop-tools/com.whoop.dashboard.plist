<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.whoop.dashboard</string>
  <key>ProgramArguments</key>
  <array><string>__WHOOP_TOOLS_DIR__/.venv/bin/python</string><string>__WHOOP_TOOLS_DIR__/dashboard.py</string></array>
  <key>WorkingDirectory</key><string>__WHOOP_TOOLS_DIR__</string>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__WHOOP_TOOLS_DIR__/dashboard.out.log</string>
  <key>StandardErrorPath</key><string>__WHOOP_TOOLS_DIR__/dashboard.err.log</string>
</dict></plist>
