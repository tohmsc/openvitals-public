<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.whoop.cloudsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WHOOP_TOOLS_DIR__/.venv/bin/python</string>
    <string>__WHOOP_TOOLS_DIR__/cloud_sync.py</string>
    <string>--auto</string>
  </array>
  <key>WorkingDirectory</key><string>__WHOOP_TOOLS_DIR__</string>
  <key>StartInterval</key><integer>180</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__WHOOP_TOOLS_DIR__/cloudsync.out.log</string>
  <key>StandardErrorPath</key><string>__WHOOP_TOOLS_DIR__/cloudsync.err.log</string>
</dict>
</plist>
