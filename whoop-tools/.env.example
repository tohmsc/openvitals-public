# Copy to .env and fill from your app at https://developer.whoop.com
# The redirect URI in your WHOOP app MUST be exactly: http://localhost:8765/callback
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here
WHOOP_REDIRECT_URI=http://localhost:8765/callback
# Optional: CoreBluetooth address of your strap (printed by ble_scan.py). Leave blank to auto-discover by service UUID.
WHOOP_BLE_ADDRESS=
# Optional: move raw strap frames to a Cloudflare R2 bucket and delete them locally (archive.py).
# Needs the Cloudflare CLI logged in (`npx wrangler login`) or CF_R2_API_TOKEN (Workers R2 Storage: Edit).
#CF_R2_BUCKET=whoop-raw-archive
#CF_R2_KEEP_HOURS=24
# Optional: a daily health summary on Telegram (telegram_report.py). Create a bot with @BotFather,
# set its token, then run `python telegram_report.py pair` and send the code it prints to the bot.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_DAILY_HOUR=8
